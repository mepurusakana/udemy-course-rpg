  dialogues:
  - characterName: "\u5C0F\u5D50 "
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u547C\u3001\u547C\u2026\u2026\u5F97\u6551\u4E86\u2026\u2026"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50 "
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u8B1D\u8B1D\u59B3\uFF01"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50 "
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u8ACB\u554F\u2026\u2026\u59B3\u662F\u8AB0\uFF1F"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50 "
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u9019\u88E1\u53C8\u662F\u4EC0\u9EBC\u5730\u65B9\u2026\u2026\uFF1F"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u6211\u662F\u8389\u8389\u7D72\u30FB\u4E9E\u745F\u6D85\u3002"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u908A\u5883\u4EA1\u9748\u7BA1\u7406\u54E1\u3002"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u9019\u88E1\u662F\u5730\u7344\n\u800C\u59B3\u2026\u2026\u6C92\u6709\u6B7B\u8005\u8A72\u6709\u7684\u6C23\u606F\n"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u59B3\u662F\u5F9E\u54EA\u88E1\u4F86\u7684\uFF1F"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: " \u6211\u3001\u6211\u8A18\u5F97\u2026\u2026\r\n"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u672C\u4F86\u548C\u670B\u53CB\u5728\u5C71\u4E0A\u73A9\u2026\u2026\n\u7136\u5F8C\u767C\u73FE\u4E86\u4E00\u500B\u5F88\u5927\u7684\u6D1E\u7A74"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u88E1\u9762\u6709\u597D\u591A\u77F3\u7891...\n\u6211\u78B0\u4E86\u5176\u4E2D\u4E00\u584A\u5F8C\uFF0C\u5C31\u4EC0\u9EBC\u90FD\u4E0D\u8A18\u5F97\u4E86\u2026\u2026"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u77F3\u7891\u2026\u2026\u796D\u58C7\u55CE\uFF1F\n\u807D\u8D77\u4F86\u59B3\u662F\u5F9E\u796D\u58C7\u50B3\u9001\u904E\u4F86\u7684"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u90A3\u88E1\u662F\u9748\u754C\u8207\u4EBA\u754C\u552F\u4E00\u7684\u901A\u9053"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u9019\u88E1\u4E0D\u662F\u751F\u8005\u8A72\u5F85\u7684\u5730\u65B9\n\u6211\u5FC5\u9808\u9001\u59B3\u56DE\u53BB"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u771F\u7684\u55CE\uFF01\uFF1F\n\u592A\u597D\u4E86\uFF01\u8B1D\u8B1D\u8389\u8389\u7D72\u59D0\u59D0\uFF01"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u4E0D\u5FC5\u9053\u8B1D\n\u6211\u53EA\u662F\u60F3\u65E9\u9EDE\u89E3\u6C7A\u9EBB\u7169\u800C\u5DF2"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u6211\u5011\u8981\u524D\u5F80\u68EE\u6797\u6DF1\u8655\u7684\u6D1E\u7A74\u796D\u58C7\n\u90A3\u88E1\u6709\u901A\u5F80\u4EBA\u754C\u7684\u901A\u9053"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u4F46\u8DEF\u9014\u9059\u9060\uFF0C\u6CBF\u9014\u602A\u7269\u773E\u591A\u2026\n\u796D\u58C7\u524D\u9084\u6709\u500B\u96E3\u7E8F\u7684\u50A2\u4F19\n\u59B3\u8981\u597D\u597D\u8DDF\u7DCA\u6211\u3002\u660E\u767D\u4E86\u55CE\uFF1F"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u6211\u5011\u8981\u524D\u5F80\u68EE\u6797\u6DF1\u8655\u7684\u6D1E\u7A74\u796D\u58C7\n\u90A3\u88E1\u6709\u901A\u5F80\u4EBA\u754C\u7684\u901A\u9053"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u660E\u767D\uFF01"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u2026\u5C0D\u4E86\uFF0C\u6211\u9084\u4E0D\u77E5\u9053\u59B3\u7684\u540D\u5B57"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50 "
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u6211\u53EB\u8607\u5C0F\u5D50\n\u59D0\u59D0\u53EB\u6211\u5C0F\u5D50\u5C31\u597D!"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u5C0F\u5D50\u2026\u2026\u597D\n\u90A3\u9EBC\uFF0C\u51FA\u767C\u5427\u3002"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
