  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u5982\u679C\u6709\u7DE3\u7684\u8A71\uFF0C\u6211\u5011\u4E00\u5B9A\u6703\u518D\u898B\u7684\u5C0D\u5427\uFF1F"
