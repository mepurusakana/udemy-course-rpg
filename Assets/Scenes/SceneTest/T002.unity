    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u597D\u4E86\n\u59B3\u53EF\u4EE5\u56DE\u53BB\u4E86"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u8389\u8389\u7D72\u59D0\u59D0\u2026\u2026\n\u771F\u7684\u3001\u771F\u7684\u975E\u5E38\u8B1D\u8B1D\u59B3"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u8981\u4E0D\u662F\u59B3\uFF0C\u6211\u80AF\u5B9A\u2026\u2026"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u5225\u8AAA\u5EE2\u8A71\u4E86\n\u5FEB\u56DE\u53BB\u5427\uFF0C\u59B3\u5BB6\u4EBA\u61C9\u8A72\u5F88\u64D4\u5FC3"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
