  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u2026\u2026\u524D\u9762\u6C92\u8DEF\u4E86\u3002"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u5947\u602A\uFF0C\u6211\u8A18\u5F97\u9019\u88E1\u4E0D\u662F\u9019\u6A23\u7684\u3002"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u5947\u602A\uFF0C\u6211\u8A18\u5F97\u9019\u88E1\u4E0D\u662F\u9019\u6A23\u7684\u3002"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 0
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50:"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u8389\u8389\u7D72\u59D0\u59D0\uFF0C\u9019\u908A\u6709\u544A\u793A\u724C\uFF01"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50:"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u4E0A\u9762\u5BEB\u8457\u2026\u2026\n\"\u89F8\u767C\u96D5\u50CF\uFF0C\u9053\u8DEF\u5C07\u6703\u6D6E\u73FE\""
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50:"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u53EF\u662F\u96D5\u50CF\u5728\u61F8\u5D16\u5C0D\u9762\u8036\u2026\u2026\n\u6211\u5011\u8A72\u600E\u9EBC\u8FA6\uFF1F"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72"
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u2026\u2026\u8B93\u6211\u60F3\u60F3\n\u4E5F\u8A31\u53EF\u4EE5\u8A66\u8A66\u9060\u7A0B\u653B\u64CA\u3002"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u5C0F\u5D50"
    characterImage: {fileID: 21300000, guid: bf47fc83fb5a12c419d51e7a94e2d7ef, type: 3}
    dialogueText: "\u9060\u7A0B\u653B\u64CA\uFF1F\n\u8389\u8389\u7D72\u59D0\u59D0\u6703\u90A3\u7A2E\u6280\u80FD\u55CE\uFF01\uFF1F"
    nameTagColor: {r: 0, g: 0, b: 0, a: 0}
    characterPosition: 1
    dialogueBoxPosition: 0
  - characterName: "\u8389\u8389\u7D72 "
    characterImage: {fileID: 21300000, guid: 2a5f317cd97aea4489ba28824d1c740d, type: 3}
    dialogueText: "\u7BA1\u7406\u54E1\u7684\u57FA\u672C\u6280\u80FD\u800C\u5DF2\n\u59B3\u9000\u5F8C\u4E00\u9EDE"
