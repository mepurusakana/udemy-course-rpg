    dialogueText: "\u5076\u723E\u63DB\u500B\u74B0\u5883\u4E5F\u4E0D\u932F\n\u524D\u63D0\u662F\u59B3\u5225\u518D\u4E82\u78B0\u4EC0\u9EBC\u5947\u602A\u7684\u6771\u897F\u4E86\u3002"
